<!DOCTYPE html>
<html>
<head>

<title>BERAKAH Cart</title>

<style>

body{
  font-family:Arial;
  background:#f5f5f5;
  padding:30px;
}

.cart-item{
  background:white;
  padding:20px;
  margin:20px auto;
  max-width:500px;
  border-radius:10px;
}

.cart-item img{
  width:100%;
  max-height:250px;
  object-fit:cover;
  border-radius:10px;
}

.price{
  font-size:24px;
  font-weight:bold;
}

button{
  padding:12px;
  width:100%;
  background:#111827;
  color:white;
  border:none;
  margin-top:10px;
  cursor:pointer;
}

.total{
  background:white;
  padding:20px;
  margin:20px auto;
  max-width:500px;
  border-radius:10px;
  font-size:26px;
  font-weight:bold;
}

</style>

</head>

<body>

<h1>🛒 BERAKAH CART</h1>

<div id="cart"></div>

<div id="total"></div>

<script>

let cartContainer = document.getElementById("cart");

let totalContainer = document.getElementById("total");

let cart = JSON.parse(
  localStorage.getItem("berakahCart") || "[]"
);


if(cart.length === 0){

  cartContainer.innerHTML = `
    <h2>Your cart is empty.</h2>
  `;

}else{

  let total = 0;

  cart.forEach(function(product){

    total += Number(product.price) || 0;

    let item = document.createElement("div");

    item.className = "cart-item";

    item.innerHTML = `

      ${product.image ?
      `<img src="${product.image}">`
      :
      `<div style="font-size:60px;text-align:center;">🛍️</div>`
      }

      <h2>${product.name}</h2>

      <div class="price">
        $${product.price}
      </div>

      <p>${product.description || ""}</p>

    `;

    cartContainer.appendChild(item);

  });


  totalContainer.innerHTML = `

    TOTAL: $${total}

    <button onclick="alert('CHECKOUT COMING NEXT 🚀')">
      CHECKOUT
    </button>

  `;

}

</script>

</body>
</html>
