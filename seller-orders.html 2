<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>EPHPHAVORA - Seller Orders</title>

<style>

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f5f7fb;
  color: #111827;
}

header {
  background: white;
  border-bottom: 1px solid #e5e7eb;
  padding: 16px 20px;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-inner {
  max-width: 1100px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

.logo {
  font-size: 24px;
  font-weight: bold;
}

.logo span {
  display: block;
  font-size: 13px;
  color: #6b7280;
  margin-top: 3px;
}

.nav {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.nav a {
  text-decoration: none;
  color: #111827;
  background: #f3f4f6;
  padding: 9px 12px;
  border-radius: 7px;
  font-size: 13px;
}

main {
  max-width: 1100px;
  margin: 25px auto;
  padding: 0 15px 50px;
}

h1 {
  margin-bottom: 5px;
}

.subtitle {
  color: #6b7280;
  margin-top: 0;
}

.refresh {
  margin: 15px 0;
  border: 0;
  background: #111827;
  color: white;
  padding: 11px 16px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
}

.message {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 18px;
  margin-top: 15px;
}

.error {
  color: #b91c1c;
}

.empty {
  text-align: center;
  padding: 40px 20px;
  color: #6b7280;
}

.order-card {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 20px;
  margin-top: 18px;
  box-shadow: 0 2px 7px rgba(0,0,0,0.04);
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  flex-wrap: wrap;
  border-bottom: 1px solid #e5e7eb;
  padding-bottom: 15px;
}

.order-number {
  font-weight: bold;
  font-size: 17px;
}

.date {
  color: #6b7280;
  font-size: 13px;
  margin-top: 5px;
}

.status {
  padding: 7px 12px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: bold;
  text-transform: uppercase;
}

.status.pending {
  background: #fef3c7;
  color: #92400e;
}

.status.confirmed {
  background: #dcfce7;
  color: #166534;
}

.status.processing {
  background: #dbeafe;
  color: #1e40af;
}

.status.shipped {
  background: #e0e7ff;
  color: #3730a3;
}

.status.delivered {
  background: #d1fae5;
  color: #065f46;
}

.status.cancelled {
  background: #fee2e2;
  color: #991b1b;
}

.status.unknown {
  background: #e5e7eb;
  color: #374151;
}

.order-body {
  padding-top: 18px;
}

.product-name {
  font-size: 19px;
  font-weight: bold;
  margin-bottom: 15px;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 12px;
}

.info {
  background: #f9fafb;
  padding: 12px;
  border-radius: 8px;
}

.label {
  display: block;
  color: #6b7280;
  font-size: 12px;
  margin-bottom: 5px;
}

.value {
  font-weight: 600;
  word-break: break-word;
}

.customer-box {
  margin-top: 18px;
  background: #f9fafb;
  padding: 15px;
  border-radius: 9px;
}

.customer-box h3 {
  margin-top: 0;
  margin-bottom: 12px;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.action-btn {
  border: 0;
  border-radius: 8px;
  padding: 10px 14px;
  cursor: pointer;
  font-weight: bold;
  font-size: 13px;
}

.process-btn {
  background: #2563eb;
  color: white;
}

.ship-btn {
  background: #4f46e5;
  color: white;
}

.deliver-btn {
  background: #059669;
  color: white;
}

.cancel-btn {
  background: #dc2626;
  color: white;
}

.action-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.payment-paid {
  color: #047857;
  font-weight: bold;
}

.payment-pending {
  color: #92400e;
  font-weight: bold;
}

.loading {
  text-align: center;
  padding: 30px;
  color: #6b7280;
}

@media (max-width: 700px) {

  .header-inner {
    flex-direction: column;
    align-items: flex-start;
  }

  .nav {
    width: 100%;
  }

}

</style>

</head>

<body>

<header>

  <div class="header-inner">

    <div class="logo">
      EPHPHAVORA
      <span>Seller Dashboard</span>
    </div>

    <nav class="nav">

      <a href="index.html">Home</a>

      <a href="marketplace.html">Market</a>

      <a href="orders.html">My Orders</a>

      <a href="profile.html">Profile</a>

    </nav>

  </div>

</header>

<main>

  <h1>📦 SELLER ORDERS</h1>

  <p class="subtitle">
    Manage orders for your products.
  </p>

  <button
    class="refresh"
    onclick="loadSellerOrders()"
  >
    🔄 REFRESH ORDERS
  </button>

  <div id="message" class="message">
    Loading orders...
  </div>

  <div id="orders"></div>

</main>

<script>

const SUPABASE_URL =
  "https://utoyoglycqjmqznczfxa.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_OypM4-7GHnq_n8-HRhw-dA_Ehzak_CA";

const ACCESS_KEY =
  "berakah_access_token";


function getAccessToken() {

  return localStorage.getItem(
    ACCESS_KEY
  );

}


async function getCurrentUser() {

  const token =
    getAccessToken();

  if (!token) {

    throw new Error(
      "You are not logged in."
    );

  }

  const response =
    await fetch(
      `${SUPABASE_URL}/auth/v1/user`,
      {
        headers: {
          "apikey":
            SUPABASE_KEY,

          "Authorization":
            `Bearer ${token}`
        }
      }
    );

  if (!response.ok) {

    throw new Error(
      "Your login session has expired."
    );

  }

  return await response.json();

}


function escapeHtml(value) {

  return String(value ?? "")
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&#039;"
    );

}


function formatMoney(value) {

  return Number(
    value || 0
  ).toLocaleString(
    "en-US",
    {
      style: "currency",
      currency: "USD"
    }
  );

}


function formatDate(value) {

  if (!value) return "—";

  const date =
    new Date(value);

  if (
    isNaN(
      date.getTime()
    )
  ) {

    return value;

  }

  return date.toLocaleString();

}


function getStatus(status) {

  const allowed = [

    "pending",
    "confirmed",
    "processing",
    "shipped",
    "delivered",
    "cancelled"

  ];

  const clean =
    String(
      status || ""
    )
    .toLowerCase()
    .trim();

  if (
    !allowed.includes(clean)
  ) {

    return {
      text: "Unknown",
      className: "unknown"
    };

  }

  return {
    text: clean,
    className: clean
  };

}


function createActionButton(
  text,
  className,
  orderId,
  newStatus
) {

  const button =
    document.createElement(
      "button"
    );

  button.className =
    `action-btn ${className}`;

  button.textContent =
    text;

  button.onclick = () =>
    updateOrderStatus(
      orderId,
      newStatus,
      button
    );

  return button;

}


function buildActions(order) {

  const actions =
    document.createElement(
      "div"
    );

  actions.className =
    "actions";

  const status =
    String(
      order.status || ""
    )
    .toLowerCase()
    .trim();

  if (
    status === "pending" ||
    status === "confirmed"
  ) {

    actions.appendChild(
      createActionButton(
        "START PROCESSING",
        "process-btn",
        order.id,
        "processing"
      )
    );

    actions.appendChild(
      createActionButton(
        "CANCEL ORDER",
        "cancel-btn",
        order.id,
        "cancelled"
      )
    );

  }

  else if (
    status === "processing"
  ) {

    actions.appendChild(
      createActionButton(
        "MARK SHIPPED",
        "ship-btn",
        order.id,
        "shipped"
      )
    );

    actions.appendChild(
      createActionButton(
        "CANCEL ORDER",
        "cancel-btn",
        order.id,
        "cancelled"
      )
    );

  }

  else if (
    status === "shipped"
  ) {

    actions.appendChild(
      createActionButton(
        "MARK DELIVERED",
        "deliver-btn",
        order.id,
        "delivered"
      )
    );

  }

  return actions;

}


async function updateOrderStatus(
  orderId,
  newStatus,
  button
) {

  const token =
    getAccessToken();

  if (!token) {

    alert(
      "Please log in again."
    );

    return;

  }

  let confirmation = true;

  if (
    newStatus === "cancelled"
  ) {

    confirmation =
      confirm(
        "Are you sure you want to cancel this order?"
      );

  }

  if (!confirmation) {
    return;
  }

  button.disabled = true;

  const oldText =
    button.textContent;

  button.textContent =
    "UPDATING...";

  try {

    const response =
      await fetch(

        `${SUPABASE_URL}/rest/v1/orders?id=eq.${encodeURIComponent(orderId)}`,

        {
          method: "PATCH",

          headers: {

            "apikey":
              SUPABASE_KEY,

            "Authorization":
              `Bearer ${token}`,

            "Content-Type":
              "application/json",

            "Prefer":
              "return=minimal"

          },

          body: JSON.stringify({

            status:
              newStatus,

            updated_at:
              new Date().toISOString()

          })

        }

      );

    const result =
      await response.text();

    if (!response.ok) {

      console.error(
        "STATUS UPDATE ERROR:",
        result
      );

      throw new Error(
        result ||
        `Unable to change order to ${newStatus}.`
      );

    }

    alert(
      `Order updated to ${newStatus.toUpperCase()}.`
    );

    await loadSellerOrders();

  }

  catch (error) {

    console.error(error);

    alert(
      "Could not update the order.\n\n" +
      error.message
    );

    button.disabled =
      false;

    button.textContent =
      oldText;

  }

}


async function loadSellerOrders() {

  const message =
    document.getElementById(
      "message"
    );

  const ordersContainer =
    document.getElementById(
      "orders"
    );

  message.style.display =
    "block";

  message.className =
    "message";

  message.textContent =
    "Loading seller orders...";

  ordersContainer.innerHTML =
    "";

  try {

    const user =
      await getCurrentUser();

    const token =
      getAccessToken();

    const url =
      `${SUPABASE_URL}/rest/v1/orders` +
      `?select=*` +
      `&seller_id=eq.${encodeURIComponent(user.id)}` +
      `&order=created_at.desc`;

    const response =
      await fetch(
        url,
        {
          headers: {

            "apikey":
              SUPABASE_KEY,

            "Authorization":
              `Bearer ${token}`,

            "Content-Type":
              "application/json"

          }
        }
      );

    const data =
      await response.json();

    if (!response.ok) {

      console.error(
        "SELLER ORDERS ERROR:",
        data
      );

      throw new Error(
        data.message ||
        data.hint ||
        "Could not load seller orders."
      );

    }

    message.style.display =
      "none";

    if (
      !Array.isArray(data) ||
      data.length === 0
    ) {

      ordersContainer.innerHTML = `

        <div class="message empty">

          <h2>
            No seller orders yet
          </h2>

          <p>
            When a customer purchases
            one of your products,
            the order will appear here.
          </p>

        </div>

      `;

      return;

    }

    data.forEach(
      order => {

        const status =
          getStatus(
            order.status
          );

        const productName =
          order.product_name ||
          "Product";

        const quantity =
          order.quantity ?? 0;

        const price =
          order.price ?? 0;

        const total =
          order.total ?? 0;

        const customerName =
          order.customer_name ||
          order.shipping_name ||
          "Customer";

        const customerEmail =
          order.customer_email ||
          "—";

        const customerPhone =
          order.customer_phone ||
          "—";

        const shippingAddress =
          order.shipping_address ||
          order.customer_address ||
          "—";

        const card =
          document.createElement(
            "div"
          );

        card.className =
          "order-card";

        const paymentStatus =
          String(
            order.payment_status ||
            "pending"
          )
          .toLowerCase();

        const paymentClass =
          paymentStatus === "paid"
            ? "payment-paid"
            : "payment-pending";

        card.innerHTML = `

          <div class="order-top">

            <div>

              <div class="order-number">

                Order #

                ${escapeHtml(
                  order.order_number ||
                  order.id ||
                  "—"
                )}

              </div>

              <div class="date">

                ${formatDate(
                  order.created_at
                )}

              </div>

            </div>

            <div
              class="status ${status.className}"
            >

              ${escapeHtml(
                status.text
              )}

            </div>

          </div>

          <div class="order-body">

            <div class="product-name">

              ${escapeHtml(
                productName
              )}

            </div>

            <div class="info-grid">

              <div class="info">

                <span class="label">
                  Quantity
                </span>

                <span class="value">
                  ${escapeHtml(quantity)}
                </span>

              </div>

              <div class="info">

                <span class="label">
                  Price
                </span>

                <span class="value">
                  ${formatMoney(price)}
                </span>

              </div>

              <div class="info">

                <span class="label">
                  Order Total
                </span>

                <span class="value">
                  ${formatMoney(total)}
                </span>

              </div>

              <div class="info">

                <span class="label">
                  Payment
                </span>

                <span
                  class="value ${paymentClass}"
                >

                  ${escapeHtml(
                    paymentStatus
                  )}

                </span>

              </div>

            </div>

            <div class="customer-box">

              <h3>
                Customer
              </h3>

              <div class="info-grid">

                <div class="info">

                  <span class="label">
                    Name
                  </span>

                  <span class="value">
                    ${escapeHtml(
                      customerName
                    )}
                  </span>

                </div>

                <div class="info">

                  <span class="label">
                    Email
                  </span>

                  <span class="value">
                    ${escapeHtml(
                      customerEmail
                    )}
                  </span>

                </div>

                <div class="info">

                  <span class="label">
                    Phone
                  </span>

                  <span class="value">
                    ${escapeHtml(
                      customerPhone
                    )}
                  </span>

                </div>

                <div class="info">

                  <span class="label">
                    Shipping Address
                  </span>

                  <span class="value">
                    ${escapeHtml(
                      shippingAddress
                    )}
                  </span>

                </div>

              </div>

            </div>

          </div>

        `;

        const actions =
          buildActions(order);

        if (
          actions.children.length > 0
        ) {

          card
            .querySelector(
              ".order-body"
            )
            .appendChild(
              actions
            );

        }

        ordersContainer
          .appendChild(
            card
          );

      }
    );

  }

  catch (error) {

    console.error(error);

    message.style.display =
      "block";

    message.className =
      "message error";

    message.innerHTML = `

      <strong>
        Error:
      </strong>

      <br>

      ${escapeHtml(
        error.message
      )}

    `;

  }

}


loadSellerOrders();

</script>

</body>

</html>
