<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0"><title>EPHPHAVORA - Seller Orders</title><style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f5f7fb;
  color: #111827;
}

header {
  background: white;
  border-bottom: 1px solid #e5e7eb;
  padding: 16px 20px;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-inner {
  max-width: 1100px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

.logo {
  font-size: 24px;
  font-weight: bold;
  color: #111827;
}

.logo span {
  font-size: 13px;
  display: block;
  color: #6b7280;
  margin-top: 2px;
}

.back-btn {
  text-decoration: none;
  background: #111827;
  color: white;
  padding: 10px 15px;
  border-radius: 8px;
  font-size: 14px;
}

main {
  max-width: 1100px;
  margin: 25px auto;
  padding: 0 15px;
}

h1 {
  margin-bottom: 5px;
}

.subtitle {
  color: #6b7280;
  margin-top: 0;
}

.message {
  background: white;
  padding: 18px;
  border-radius: 10px;
  border: 1px solid #e5e7eb;
  margin-top: 20px;
}

.order-card {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 20px;
  margin-top: 18px;
  box-shadow: 0 2px 7px rgba(0,0,0,0.04);
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  flex-wrap: wrap;
  border-bottom: 1px solid #e5e7eb;
  padding-bottom: 15px;
}

.order-number {
  font-weight: bold;
  font-size: 17px;
}

.date {
  color: #6b7280;
  font-size: 13px;
  margin-top: 5px;
}

.status {
  padding: 7px 12px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: bold;
  text-transform: capitalize;
}

.status.pending {
  background: #fef3c7;
  color: #92400e;
}

.status.confirmed {
  background: #dcfce7;
  color: #166534;
}

.status.processing {
  background: #dbeafe;
  color: #1e40af;
}

.status.shipped {
  background: #e0e7ff;
  color: #3730a3;
}

.status.delivered {
  background: #d1fae5;
  color: #065f46;
}

.status.cancelled {
  background: #fee2e2;
  color: #991b1b;
}

.status.unknown {
  background: #e5e7eb;
  color: #374151;
}

.order-body {
  padding-top: 18px;
}

.product-name {
  font-size: 19px;
  font-weight: bold;
  margin-bottom: 12px;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 12px;
}

.info {
  background: #f9fafb;
  padding: 12px;
  border-radius: 8px;
}

.label {
  display: block;
  color: #6b7280;
  font-size: 12px;
  margin-bottom: 5px;
}

.value {
  font-weight: 600;
}

.customer-box {
  margin-top: 18px;
  background: #f9fafb;
  padding: 15px;
  border-radius: 9px;
}

.customer-box h3 {
  margin-top: 0;
  margin-bottom: 12px;
}

.refresh {
  margin-top: 20px;
  border: 0;
  background: #111827;
  color: white;
  padding: 11px 16px;
  border-radius: 8px;
  cursor: pointer;
}

.refresh:hover {
  opacity: 0.9;
}

.loading {
  text-align: center;
  padding: 30px;
  color: #6b7280;
}

.error {
  color: #b91c1c;
}

.empty {
  text-align: center;
  padding: 40px 20px;
  color: #6b7280;
}
</style></head><body><header>
  <div class="header-inner">
    <div class="logo">
      EPHPHAVORA
      <span>Seller Orders</span>
    </div><a class="back-btn" href="index.html">← Back</a>

  </div>
</header><main>  <h1>Seller Orders</h1>
  <p class="subtitle">
    Orders containing products that you are selling.
  </p>  <button class="refresh" onclick="loadSellerOrders()">
    Refresh Orders
  </button>  <div id="message" class="message">
    Loading orders...
  </div>  <div id="orders"></div></main><script>

const SUPABASE_URL =
  "https://utoyoglycqjmqznczfxa.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_OypM4-7GHnq_n8-HRhw-dA_Ehzak_CA";

const ACCESS_KEY = "berakah_access_token";

function getAccessToken() {
  return localStorage.getItem(ACCESS_KEY);
}

async function getCurrentUser() {

  const token = getAccessToken();

  if (!token) {
    throw new Error("You are not logged in.");
  }

  const response = await fetch(
    `${SUPABASE_URL}/auth/v1/user`,
    {
      headers: {
        "apikey": SUPABASE_KEY,
        "Authorization": `Bearer ${token}`
      }
    }
  );

  if (!response.ok) {
    throw new Error("Your login session has expired.");
  }

  return await response.json();
}

function formatMoney(value) {

  const number = Number(value || 0);

  return number.toLocaleString("en-US", {
    style: "currency",
    currency: "USD"
  });
}

function formatDate(value) {

  if (!value) return "—";

  const date = new Date(value);

  if (isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleString();
}

function getStatus(status) {

  const allowed = [
    "pending",
    "confirmed",
    "processing",
    "shipped",
    "delivered",
    "cancelled"
  ];

  const clean = String(status || "")
    .toLowerCase()
    .trim();

  if (!allowed.includes(clean)) {
    return {
      text: "Unknown",
      className: "unknown"
    };
  }

  return {
    text: clean,
    className: clean
  };
}

async function loadSellerOrders() {

  const message = document.getElementById("message");
  const ordersContainer = document.getElementById("orders");

  message.className = "message";
  message.textContent = "Loading seller orders...";

  ordersContainer.innerHTML = "";

  try {

    const user = await getCurrentUser();

    /*
      IMPORTANT:
      Seller orders are filtered by seller_id,
      using the REAL Supabase Auth UUID.
    */

    const url =
      `${SUPABASE_URL}/rest/v1/orders` +
      `?select=*` +
      `&seller_id=eq.${encodeURIComponent(user.id)}` +
      `&order=created_at.desc`;

    const response = await fetch(url, {
      headers: {
        "apikey": SUPABASE_KEY,
        "Authorization": `Bearer ${getAccessToken()}`,
        "Content-Type": "application/json"
      }
    });

    const data = await response.json();

    if (!response.ok) {

      console.error("Seller orders error:", data);

      throw new Error(
        data.message ||
        data.hint ||
        "Could not load seller orders."
      );
    }

    message.style.display = "none";

    if (!Array.isArray(data) || data.length === 0) {

      ordersContainer.innerHTML = `
        <div class="message empty">
          <h2>No seller orders yet</h2>
          <p>
            When a customer purchases one of your products,
            the order will appear here.
          </p>
        </div>
      `;

      return;
    }

    data.forEach(order => {

      const status = getStatus(order.status);

      const productName =
        order.product_name ||
        "Product";

      const quantity =
        order.quantity ?? 0;

      const price =
        order.price ?? 0;

      const total =
        order.total ?? 0;

      const customerName =
        order.customer_name ||
        order.shipping_name ||
        "Customer";

      const customerEmail =
        order.customer_email ||
        "—";

      const customerPhone =
        order.customer_phone ||
        "—";

      const shippingAddress =
        order.shipping_address ||
        order.customer_address ||
        "—";

      const card = document.createElement("div");

      card.className = "order-card";

      card.innerHTML = `

        <div class="order-top">

          <div>
            <div class="order-number">
              Order #${escapeHtml(
                order.order_number || order.id || "—"
              )}
            </div>

            <div class="date">
              ${formatDate(order.created_at)}
            </div>
          </div>

          <div class="status ${status.className}">
            ${escapeHtml(status.text)}
          </div>

        </div>

        <div class="order-body">

          <div class="product-name">
            ${escapeHtml(productName)}
          </div>

          <div class="info-grid">

            <div class="info">
              <span class="label">Quantity</span>
              <span class="value">
                ${escapeHtml(quantity)}
              </span>
            </div>

            <div class="info">
              <span class="label">Price</span>
              <span class="value">
                ${formatMoney(price)}
              </span>
            </div>

            <div class="info">
              <span class="label">Order Total</span>
              <span class="value">
                ${formatMoney(total)}
              </span>
            </div>

            <div class="info">
              <span class="label">Payment</span>
              <span class="value">
                ${escapeHtml(
                  order.payment_status || "—"
                )}
              </span>
            </div>

          </div>

          <div class="customer-box">

            <h3>Customer Information</h3>

            <div class="info-grid">

              <div class="info">
                <span class="label">Name</span>
                <span class="value">
                  ${escapeHtml(customerName)}
                </span>
              </div>

              <div class="info">
                <span class="label">Email</span>
                <span class="value">
                  ${escapeHtml(customerEmail)}
                </span>
              </div>

              <div class="info">
                <span class="label">Phone</span>
                <span class="value">
                  ${escapeHtml(customerPhone)}
                </span>
              </div>

              <div class="info">
                <span class="label">Shipping Address</span>
                <span class="value">
                  ${escapeHtml(shippingAddress)}
                </span>
              </div>

            </div>

          </div>

        </div>
      `;

      ordersContainer.appendChild(card);

    });

  } catch (error) {

    console.error(error);

    message.style.display = "block";
    message.className = "message error";
    message.innerHTML = `
      <strong>Error:</strong>
      ${escapeHtml(error.message)}
    `;
  }
}

function escapeHtml(value) {

  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

loadSellerOrders();

</script></body>
</html>
