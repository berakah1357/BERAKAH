<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>EPHPHAVORA - Seller Orders</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #111827;
    }

    header {
      background: white;
      border-bottom: 1px solid #e5e7eb;
      padding: 16px 20px;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-inner {
      max-width: 1100px;
      margin: auto;
    }

    .logo {
      font-size: 28px;
      font-weight: 800;
      color: #111827;
      margin-bottom: 4px;
    }

    .subtitle {
      color: #6b7280;
      font-size: 14px;
      margin-bottom: 14px;
    }

    nav {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    nav a {
      text-decoration: none;
      color: #374151;
      background: #f3f4f6;
      padding: 9px 13px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
    }

    nav a:hover {
      background: #e5e7eb;
    }

    main {
      max-width: 1100px;
      margin: 25px auto;
      padding: 0 16px;
    }

    .page-title {
      font-size: 26px;
      margin: 0 0 6px;
    }

    .description {
      color: #6b7280;
      margin: 0 0 18px;
    }

    .top-bar {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 18px;
    }

    button {
      border: none;
      cursor: pointer;
      font-weight: 700;
      border-radius: 8px;
      padding: 10px 15px;
      font-size: 14px;
    }

    .refresh-btn {
      background: #111827;
      color: white;
    }

    .refresh-btn:hover {
      background: #1f2937;
    }

    .status {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 18px;
      color: #374151;
      display: none;
    }

    .orders-container {
      display: grid;
      gap: 18px;
    }

    .order-card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 18px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .order-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 15px;
    }

    .order-id {
      font-size: 17px;
      font-weight: 800;
      word-break: break-word;
    }

    .order-date {
      color: #6b7280;
      font-size: 13px;
      margin-top: 4px;
    }

    .status-badge {
      padding: 7px 10px;
      border-radius: 999px;
      background: #f3f4f6;
      color: #374151;
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
    }

    .order-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }

    .info-box {
      background: #f9fafb;
      border-radius: 10px;
      padding: 12px;
    }

    .info-label {
      color: #6b7280;
      font-size: 12px;
      margin-bottom: 5px;
    }

    .info-value {
      font-weight: 700;
      word-break: break-word;
    }

    .order-total {
      font-size: 20px;
      font-weight: 800;
    }

    .actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      padding-top: 14px;
      border-top: 1px solid #e5e7eb;
    }

    .actions label {
      font-size: 13px;
      font-weight: 700;
      color: #374151;
    }

    .status-select {
      padding: 9px 10px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      background: white;
      font-size: 14px;
    }

    .save-btn {
      background: #2563eb;
      color: white;
    }

    .save-btn:hover {
      background: #1d4ed8;
    }

    .save-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .payment-paid {
      color: #15803d;
      font-weight: 800;
    }

    .payment-unpaid {
      color: #b91c1c;
      font-weight: 800;
    }

    .empty {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 35px 20px;
      text-align: center;
      color: #6b7280;
    }

    .error {
      color: #b91c1c;
      background: #fef2f2;
      border-color: #fecaca;
    }

    .success {
      color: #166534;
      background: #f0fdf4;
      border-color: #bbf7d0;
    }

    @media (max-width: 650px) {
      header {
        padding: 14px;
      }

      .logo {
        font-size: 24px;
      }

      .order-header {
        flex-direction: column;
      }

      .order-grid {
        grid-template-columns: 1fr;
      }

      .top-bar {
        justify-content: stretch;
      }

      .refresh-btn {
        width: 100%;
      }

      .actions {
        align-items: stretch;
        flex-direction: column;
      }

      .status-select,
      .save-btn {
        width: 100%;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="header-inner">

    <div class="logo">EPHPHAVORA</div>

    <div class="subtitle">
      Seller Dashboard
    </div>

    <nav>
      <a href="index.html">Home</a>
      <a href="marketplace.html">Market</a>
      <a href="orders.html">My Orders</a>
      <a href="profile.html">Profile</a>
    </nav>

  </div>
</header>

<main>

  <h1 class="page-title">📦 SELLER ORDERS</h1>

  <p class="description">
    Manage orders for your products.
  </p>

  <div class="top-bar">
    <button class="refresh-btn" id="refreshBtn">
      🔄 REFRESH ORDERS
    </button>
  </div>

  <div id="status" class="status"></div>

  <div id="ordersContainer" class="orders-container">
    <div class="empty">
      Loading your orders...
    </div>
  </div>

</main>

<script>
  const SUPABASE_URL = "https://utoyoglycqjmqznczfxa.supabase.co";

  const SUPABASE_KEY =
    "sb_publishable_OypM4-7GHnq_n8-HRhw-dA_Ehzak_CA";

  const accessToken =
    localStorage.getItem("berakah_access_token");

  const refreshToken =
    localStorage.getItem("berakah_refresh_token");

  const ordersContainer =
    document.getElementById("ordersContainer");

  const statusBox =
    document.getElementById("status");

  const refreshBtn =
    document.getElementById("refreshBtn");


  function showStatus(message, type = "") {
    statusBox.textContent = message;
    statusBox.className = "status";

    if (type) {
      statusBox.classList.add(type);
    }

    statusBox.style.display = "block";
  }


  function hideStatus() {
    statusBox.style.display = "none";
  }


  function escapeHTML(value) {
    if (value === null || value === undefined) {
      return "";
    }

    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }


  function formatDate(dateValue) {
    if (!dateValue) {
      return "—";
    }

    const date = new Date(dateValue);

    if (Number.isNaN(date.getTime())) {
      return escapeHTML(dateValue);
    }

    return date.toLocaleString();
  }


  function formatMoney(value) {
    const number = Number(value || 0);

    return "$" + number.toFixed(2);
  }


  async function getCurrentUser() {

    if (!accessToken) {
      throw new Error(
        "You are not logged in. Please log in first."
      );
    }

    const response = await fetch(
      `${SUPABASE_URL}/auth/v1/user`,
      {
        method: "GET",
        headers: {
          "apikey": SUPABASE_KEY,
          "Authorization": `Bearer ${accessToken}`
        }
      }
    );

    if (!response.ok) {
      throw new Error(
        "Your login session has expired. Please log in again."
      );
    }

    return await response.json();
  }


  async function loadOrders() {

    ordersContainer.innerHTML = `
      <div class="empty">
        Loading your orders...
      </div>
    `;

    hideStatus();

    try {

      const user = await getCurrentUser();

      if (!user || !user.id) {
        throw new Error("Unable to identify your account.");
      }

      const response = await fetch(
        `${SUPABASE_URL}/rest/v1/orders?seller_id=eq.${encodeURIComponent(user.id)}&order=created_at.desc`,
        {
          method: "GET",
          headers: {
            "apikey": SUPABASE_KEY,
            "Authorization": `Bearer ${accessToken}`,
            "Accept": "application/json"
          }
        }
      );

      if (!response.ok) {

        const errorText = await response.text();

        throw new Error(
          "Could not load your orders. " + errorText
        );
      }

      const orders = await response.json();

      renderOrders(orders);

    } catch (error) {

      console.error("EPHPHAVORA SELLER ORDERS ERROR:", error);

      ordersContainer.innerHTML = `
        <div class="empty error">
          ${escapeHTML(error.message)}
        </div>
      `;

    }
  }


  function renderOrders(orders) {

    if (!Array.isArray(orders) || orders.length === 0) {

      ordersContainer.innerHTML = `
        <div class="empty">
          <h3>No seller orders yet.</h3>
          <p>
            Orders for your products will appear here after customers make purchases.
          </p>
        </div>
      `;

      return;
    }


    ordersContainer.innerHTML = orders.map(order => {

      const paymentStatus =
        String(order.payment_status || "unknown").toLowerCase();

      const paymentHTML =
        paymentStatus === "paid"
          ? `<span class="payment-paid">PAID</span>`
          : `<span class="payment-unpaid">${escapeHTML(paymentStatus.toUpperCase())}</span>`;


      const currentStatus =
        String(order.status || "pending").toLowerCase();


      return `
        <div class="order-card">

          <div class="order-header">

            <div>
              <div class="order-id">
                Order: ${escapeHTML(
                  order.order_number ||
                  order.order_id ||
                  order.id ||
                  "—"
                )}
              </div>

              <div class="order-date">
                ${formatDate(order.created_at)}
              </div>
            </div>

            <div class="status-badge">
              ${escapeHTML(currentStatus.toUpperCase())}
            </div>

          </div>


          <div class="order-grid">

            <div class="info-box">
              <div class="info-label">
                Product
              </div>

              <div class="info-value">
                ${escapeHTML(
                  order.product_name ||
                  order.name ||
                  order.product ||
                  "Product"
                )}
              </div>
            </div>


            <div class="info-box">
              <div class="info-label">
                Quantity
              </div>

              <div class="info-value">
                ${escapeHTML(order.quantity || 1)}
              </div>
            </div>


            <div class="info-box">
              <div class="info-label">
                Total
              </div>

              <div class="info-value order-total">
                ${formatMoney(
                  order.total ||
                  order.amount ||
                  order.price ||
                  0
                )}
              </div>
            </div>


            <div class="info-box">
              <div class="info-label">
                Payment
              </div>

              <div class="info-value">
                ${paymentHTML}
              </div>
            </div>


            <div class="info-box">
              <div class="info-label">
                Customer
              </div>

              <div class="info-value">
                ${escapeHTML(
                  order.customer_name ||
                  order.customer_email ||
                  order.buyer_email ||
                  "Customer"
                )}
              </div>
            </div>


            <div class="info-box">
              <div class="info-label">
                Customer Email
              </div>

              <div class="info-value">
                ${escapeHTML(
                  order.customer_email ||
                  order.buyer_email ||
                  "—"
                )}
              </div>
            </div>

          </div>


          <div class="actions">

            <label>
              Order Status:
            </label>

            <select
              class="status-select"
              data-order-id="${escapeHTML(order.id)}"
            >

              <option value="pending"
                ${currentStatus === "pending" ? "selected" : ""}>
                Pending
              </option>

              <option value="confirmed"
                ${currentStatus === "confirmed" ? "selected" : ""}>
                Confirmed
              </option>

              <option value="processing"
                ${currentStatus === "processing" ? "selected" : ""}>
                Processing
              </option>

              <option value="shipped"
                ${currentStatus === "shipped" ? "selected" : ""}>
                Shipped
              </option>

              <option value="delivered"
                ${currentStatus === "delivered" ? "selected" : ""}>
                Delivered
              </option>

              <option value="cancelled"
                ${currentStatus === "cancelled" ? "selected" : ""}>
                Cancelled
              </option>

            </select>


            <button
              class="save-btn"
              onclick="updateOrderStatus('${escapeHTML(order.id)}', this)"
            >
              SAVE STATUS
            </button>

          </div>

        </div>
      `;

    }).join("");
  }


  async function updateOrderStatus(orderId, button) {

    const select =
      document.querySelector(
        `.status-select[data-order-id="${CSS.escape(String(orderId))}"]`
      );

    if (!select) {
      alert("Could not find the order status selector.");
      return;
    }


    const newStatus = select.value;


    button.disabled = true;
    button.textContent = "SAVING...";


    try {

      if (!accessToken) {
        throw new Error(
          "Your login session has expired. Please log in again."
        );
      }


      const response = await fetch(
        `${SUPABASE_URL}/rest/v1/orders?id=eq.${encodeURIComponent(orderId)}`,
        {
          method: "PATCH",

          headers: {
            "apikey": SUPABASE_KEY,
            "Authorization": `Bearer ${accessToken}`,
            "Content-Type": "application/json",
            "Prefer": "return=minimal"
          },

          body: JSON.stringify({
            status: newStatus
          })
        }
      );


      if (!response.ok) {

        const errorText = await response.text();

        throw new Error(
          "Could not update order status. " + errorText
        );
      }


      showStatus(
        "Order status updated successfully.",
        "success"
      );


      await loadOrders();


    } catch (error) {

      console.error(
        "EPHPHAVORA STATUS UPDATE ERROR:",
        error
      );

      showStatus(
        error.message,
        "error"
      );

    } finally {

      button.disabled = false;
      button.textContent = "SAVE STATUS";

    }
  }


  refreshBtn.addEventListener(
    "click",
    loadOrders
  );


  loadOrders();

</script>

</body>
</html>
